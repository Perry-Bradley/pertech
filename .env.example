# Required everywhere ------------------------------------------------------
# 32+ random bytes hex. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Local dev:   file:./pertech.db
# Production:  postgres://USER:PASS@HOST:PORT/DB
DATABASE_URI=file:./pertech.db

NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Required in production (Vercel only) -------------------------------------
# Vercel Blob storage token for Media uploads.
# BLOB_READ_WRITE_TOKEN=

# Secret token to authorize POST /api/seed in production (?secret=...)
# SEED_SECRET=

# Optional: override the bootstrap admin user
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
